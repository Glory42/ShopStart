{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@shopstart/types$": "<rootDir>/../../packages/types/src/index.ts"
  },
  "setupFiles": ["<rootDir>/test/env-setup.ts"],
  "maxWorkers": 1
}
