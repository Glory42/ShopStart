PORT=4001
DATABASE_URL="postgresql://shopstart:shopstart@localhost:5432/shopstart_test"

# Test-only secrets — never reuse real ones here, this file (once copied to
# .env.test) is read by the e2e suite, not production.
JWT_ACCESS_SECRET="test-access-secret-do-not-use-in-prod"
JWT_REFRESH_SECRET="test-refresh-secret-do-not-use-in-prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
